# Copy this file to /etc/jsys/jsys.env on the Chinese-instance server.
# Replace every value there; do not commit the real file or send it in chat.

# First migration only: Owner of the historic workspace named 中国账号.
CHINA_ACCOUNT_EMAIL=replace-with-china-owner-email
CHINA_ACCOUNT_PASSWORD=replace-with-a-unique-8-to-128-character-password

# First seed only: unlinked internal administrator at /platform.
PLATFORM_ADMIN_EMAIL=replace-with-platform-admin-email
PLATFORM_ADMIN_PASSWORD=replace-with-a-unique-8-to-128-character-password
